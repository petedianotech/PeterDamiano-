{
  "entities": {
    "projects": {
      "title": "Portfolio Projects & Systems",
      "description": "Showcase systems and applications created by Peter Damiano",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Name of the project or system" },
        "subtitle": { "type": "string", "description": "Short headline" },
        "description": { "type": "string", "description": "Summary of what the project does" },
        "category": { "type": "string", "enum": ["web", "mobile", "ai", "hardware", "other"], "description": "Category" },
        "liveUrl": { "type": "string", "description": "Live URL or demo link" },
        "githubUrl": { "type": "string", "description": "GitHub repository URL" },
        "imageUrl": { "type": "string", "description": "Screenshot or cover image URL from ImgBB" },
        "status": { "type": "string", "enum": ["Live", "In Progress", "Beta", "Restricted"], "description": "Current status" },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Technologies and badges" },
        "order": { "type": "number", "description": "Display order" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "status"]
    },
    "blogs": {
      "title": "Blog Posts & Articles",
      "description": "Articles and thoughts written by Peter Damiano",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Blog post title" },
        "slug": { "type": "string", "description": "URL-friendly slug" },
        "excerpt": { "type": "string", "description": "Short summary" },
        "content": { "type": "string", "description": "Full article markdown or text content" },
        "coverImage": { "type": "string", "description": "Cover image URL from ImgBB" },
        "category": { "type": "string", "description": "Blog category" },
        "tags": { "type": "array", "items": { "type": "string" }, "description": "Tags" },
        "published": { "type": "boolean", "description": "Publication status" },
        "readTime": { "type": "string", "description": "Estimated read time e.g. 4 min read" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "slug", "content", "published"]
    },
    "inquiries": {
      "title": "Client Contact Messages & Leads",
      "description": "Messages sent by visitors looking to hire or contact Peter",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Sender name" },
        "email": { "type": "string", "format": "email", "description": "Sender email" },
        "phone": { "type": "string", "description": "Sender phone or WhatsApp" },
        "service": { "type": "string", "description": "Requested project type or service" },
        "budget": { "type": "string", "description": "Estimated budget or timeline" },
        "message": { "type": "string", "description": "Message text" },
        "read": { "type": "boolean", "description": "Read status" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "message", "createdAt"]
    },
    "profile_settings": {
      "title": "Portfolio Configuration",
      "description": "Customizable profile details and availability flags",
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "whatsapp": { "type": "string" },
        "availabilityStatus": { "type": "string" },
        "announcementText": { "type": "string" },
        "announcementActive": { "type": "boolean" },
        "imgbbApiKey": { "type": "string" },
        "hourlyRateOrPricing": { "type": "string" }
      }
    }
  }
}
